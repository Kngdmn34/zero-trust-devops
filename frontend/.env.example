# ----- Tasks frontend environment variables -----
# Copy to .env.local for local dev, or set these in the CI/CD / runtime
# environment (GitHub Actions secrets, Docker env, hosting dashboard).

# REQUIRED for AI features (server-side secret — never exposed to the browser).
GROQ_API_KEY=your_groq_api_key_here

# OPTIONAL — Groq model ID. See https://console.groq.com/docs/models
# Defaults to openai/gpt-oss-20b (fast + cheap, developer plan).
GROQ_MODEL=openai/gpt-oss-20b

# OPTIONAL — Backend API base URL (the backend service built by the backend
# team). Leave empty to run in local demo mode (browser localStorage).
NEXT_PUBLIC_API_URL=

# OPTIONAL — Port for the production server (next start). Default 3000.
PORT=3000
